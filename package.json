{
  "name": "memoid",
  "version": "0.0.0-foundation",
  "private": true,
  "description": "Memoid production foundation (Stage 8B; no product features)",
  "license": "UNLICENSED",
  "type": "module",
  "packageManager": "pnpm@11.24.0",
  "engines": {
    "node": ">=24.18.0 <25",
    "pnpm": ">=11.24.0 <12"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --parallel",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . && dependency-cruiser --config dependency-cruiser.config.mjs apps packages tests",
    "typecheck": "tsc --noEmit -p tsconfig.check.json && turbo run typecheck",
    "test": "vitest run --exclude tests/integration/**",
    "test:security": "vitest run tests/security",
    "test:integration": "vitest run tests/integration",
    "test:e2e": "corepack pnpm --filter @memoid/web build && node tests/e2e/run.mjs",
    "test:e2e:update": "corepack pnpm --filter @memoid/web build && node tests/e2e/run.mjs --update-snapshots",
    "traceability:generate": "node --experimental-strip-types scripts/stage7-screen-traceability.ts",
    "traceability:check": "node --experimental-strip-types scripts/stage7-screen-traceability.ts --check",
    "db:migrate": "tsx packages/db/src/cli.ts migrate",
    "db:status": "tsx packages/db/src/cli.ts status",
    "db:reset": "tsx packages/db/src/cli.ts reset",
    "db:seed": "tsx packages/db/src/cli.ts seed",
    "secrets:scan": "secretlint \"**/*\" --secretlintrc .secretlintrc.json",
    "sast": "eslint --config eslint.security.config.mjs --max-warnings 0 apps packages scripts tests",
    "qa": "corepack pnpm format:check && corepack pnpm lint && corepack pnpm typecheck && corepack pnpm traceability:check && corepack pnpm test && corepack pnpm build"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@eslint/js": "10.0.1",
    "@memoid/config": "workspace:*",
    "@memoid/db": "workspace:*",
    "@memoid/jobs": "workspace:*",
    "@memoid/observability": "workspace:*",
    "@memoid/security": "workspace:*",
    "@modelcontextprotocol/fastify": "2.0.0",
    "@modelcontextprotocol/server": "2.0.0",
    "@playwright/test": "1.62.1",
    "@secretlint/secretlint-rule-preset-recommend": "13.0.5",
    "@types/node": "24.13.3",
    "dependency-cruiser": "18.2.0",
    "eslint": "10.9.1",
    "eslint-plugin-security": "4.0.1",
    "kysely": "0.29.5",
    "prettier": "3.9.6",
    "secretlint": "13.0.5",
    "tsx": "4.23.12",
    "turbo": "2.10.12",
    "typescript": "6.0.3",
    "typescript-eslint": "8.68.0",
    "vitest": "4.1.11"
  }
}
