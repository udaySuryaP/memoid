# Runtime identity: development | test | preview | staging | production
MEMOID_ENV=development
WEB_PORT=3000
API_PORT=3001
LOG_LEVEL=info
OTEL_EXPORTER_OTLP_ENDPOINT=
DATABASE_URL=postgres://memoid_app:synthetic-app-password@localhost:5432/memoid
# Used only by the trusted web authentication callback/session/webhook boundary.
AUTH_DATABASE_URL=postgres://memoid_auth:synthetic-auth-password@localhost:5432/memoid
# Used only by the authenticated GitHub webhook lifecycle boundary.
PROVIDER_DATABASE_URL=postgres://memoid_provider:synthetic-provider-password@localhost:5432/memoid
DATABASE_READINESS_TIMEOUT_MS=2000
DATABASE_ADMIN_URL=postgres://memoid_admin:synthetic-admin-password@localhost:5432/memoid
INTEGRATION_DATABASE_URL=postgres://memoid_app:synthetic-app-password@localhost:5433/memoid_test
INTEGRATION_AUTH_DATABASE_URL=postgres://memoid_auth:synthetic-auth-password@localhost:5433/memoid_test
INTEGRATION_DATABASE_ADMIN_URL=postgres://memoid_admin:synthetic-admin-password@localhost:5433/memoid_test
WORKOS_CLIENT_ID=
WORKOS_API_KEY=
WORKOS_WEBHOOK_SECRET=
MEMOID_APP_ORIGIN=https://localhost:3000
# At least 32 random bytes encoded as base64url. Do not reuse a provider secret.
MEMOID_AUTH_FLOW_SECRET=
# Separate encryption key for bounded GitHub installation/selection state.
MEMOID_GITHUB_FLOW_SECRET=
GITHUB_APP_ID=
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
GITHUB_APP_PRIVATE_KEY=
GITHUB_APP_SLUG=
GITHUB_CALLBACK_URL=https://localhost:3000/projects/github/callback
GITHUB_WEBHOOK_SECRET=
# Optional immediately previous secret during a bounded webhook-secret rotation.
GITHUB_WEBHOOK_SECRET_PREVIOUS=
AWS_REGION=
AWS_S3_BUCKET=
AWS_KMS_KEY_ID=
ANALYTICS_ENABLED=false
